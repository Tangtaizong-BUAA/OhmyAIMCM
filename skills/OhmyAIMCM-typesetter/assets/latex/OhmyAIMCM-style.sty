}

\newcommand{\OhmyAIMCMApplyFlowStyle}[4]{%
  \renewcommand{\OhmyAIMCMWidowPenalty}{#1}%
  \renewcommand{\OhmyAIMCMClubPenalty}{#2}%
  \renewcommand{\OhmyAIMCMHeadingKeepLines}{#3}%
  \csname OhmyAIMCMfirstafterheadingindent#4\endcsname
