  \par\begingroup
  \vspace*{\OhmyAIMCMHOneBefore em}%
  {\OhmyAIMCMAbstractHeadingFont\OhmyAIMCMAbstractHeadingAlignment 摘要\par}%
  \vspace{\OhmyAIMCMHOneAfter em}%
  \setlength{\parindent}{\OhmyAIMCMParagraphIndent em}%
}{%
  \par\endgroup
  \ifOhmyAIMCMabstractpagebreak\clearpage\fi
}

