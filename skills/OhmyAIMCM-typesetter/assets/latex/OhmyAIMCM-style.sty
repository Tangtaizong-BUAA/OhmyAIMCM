\makeatletter
\newcommand{\OhmyAIMCMEnableFirstIndent}{\let\@afterindentfalse\@afterindenttrue}
\makeatother

\AtBeginDocument{%
  \color{OhmyAIMCMInk}%
  \fontsize{\OhmyAIMCMBodyFontSize pt}{\OhmyAIMCMBodyLeading pt}\selectfont
  % ctexart initializes its paragraph layout at begin-document time.  Apply the
  % validated token here so that the class cannot silently overwrite it.
  \setlength{\parindent}{\OhmyAIMCMParagraphIndent em}%
  \setlength{\abovedisplayskip}{\OhmyAIMCMDisplayAbove em plus 0.2em minus 0.15em}%
  \setlength{\belowdisplayskip}{\OhmyAIMCMDisplayBelow em plus 0.2em minus 0.15em}%
  \setlength{\abovedisplayshortskip}{\OhmyAIMCMDisplayAbove em plus 0.15em minus 0.1em}%
  \setlength{\belowdisplayshortskip}{\OhmyAIMCMDisplayBelow em plus 0.15em minus 0.1em}%
  \renewcommand{\arraystretch}{\OhmyAIMCMArrayStretch}%
  \widowpenalty=\OhmyAIMCMWidowPenalty
  \clubpenalty=\OhmyAIMCMClubPenalty
  \displaywidowpenalty=\OhmyAIMCMWidowPenalty
  \ifOhmyAIMCMfirstafterheadingindent\OhmyAIMCMEnableFirstIndent\fi
}

