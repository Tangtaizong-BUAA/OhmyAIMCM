% Pagination safety, independent of the selected aesthetic Style Tokens.
% At endlongtable, box 0 contains the complete body only if LT@start has not
% run yet.  Measure that existing box and the first head/final foot; never
% typeset a trial copy (which would repeat captions, labels and footnotes).
% Streamed tables and complete tables taller than a page retain longtable's
% ordinary page-breaking output routine, including repeated heads/feet.
\makeatletter
\newdimen\OhmyAIMCM@TableHeight
\newdimen\OhmyAIMCM@TableFootHeight
\newcommand{\OhmyAIMCM@tableSavedNotes}[1]{%
  \ifvoid#1\else
    \advance\OhmyAIMCM@TableHeight\ht#1%
    \advance\OhmyAIMCM@TableHeight\dp#1%
    \advance\OhmyAIMCM@TableHeight\skip\footins
  \fi
}
\newcommand{\OhmyAIMCM@guardCompletedTable}{%
  \ifx\LT@start\endgraf
    \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=streamed}%
  \else
    \OhmyAIMCM@TableHeight=\dimexpr\ht\z@+\dp\z@\relax
    \ifvoid\LT@firsthead
      \advance\OhmyAIMCM@TableHeight\dimexpr\ht\LT@head+\dp\LT@head\relax
    \else
      \advance\OhmyAIMCM@TableHeight\dimexpr\ht\LT@firsthead+\dp\LT@firsthead\relax
    \fi
    % longtable reserves the ordinary foot before selecting the final foot.
    \OhmyAIMCM@TableFootHeight=\dimexpr\ht\LT@foot+\dp\LT@foot\relax
    \ifdim\dimexpr\ht\LT@lastfoot+\dp\LT@lastfoot\relax>\OhmyAIMCM@TableFootHeight
      \OhmyAIMCM@TableFootHeight=\dimexpr\ht\LT@lastfoot+\dp\LT@lastfoot\relax
    \fi
    \advance\OhmyAIMCM@TableHeight\OhmyAIMCM@TableFootHeight
    \advance\OhmyAIMCM@TableHeight\LTpre
    \advance\OhmyAIMCM@TableHeight\LTpost
    % Account for the natural page-top allowance and Pandoc's saved notes.
    \advance\OhmyAIMCM@TableHeight\topskip
    \@ifundefined{FNH@notes}{}{\OhmyAIMCM@tableSavedNotes\FNH@notes}%
    \@ifundefined{fn@notes}{}{\OhmyAIMCM@tableSavedNotes\fn@notes}%
    \ifdim\OhmyAIMCM@TableHeight>\textheight
      \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=breakable height=\the\OhmyAIMCM@TableHeight}%
    \else
      \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=keep height=\the\OhmyAIMCM@TableHeight}%
      \Needspace{\OhmyAIMCM@TableHeight}%
    \fi
  \fi
}
% This exact hook is shared by supported longtable releases.  A changed
% implementation must stop compilation rather than silently lose the guard.
% Replace tokens without retokenizing: current longtable mixes expl3 names and
% ordinary message spaces, which etoolbox's string patch cannot round-trip.
\ExplSyntaxOn
\group_begin:
\tl_set:No \l_tmpa_tl { \endlongtable }
\tl_if_in:NnTF \l_tmpa_tl { \LT@echunk \LT@start }
  {
    \tl_replace_once:Nnn \l_tmpa_tl
      { \LT@echunk \LT@start }
      { \LT@echunk \OhmyAIMCM@guardCompletedTable \LT@start }
    \cs_gset:Npx \endlongtable { \exp_not:V \l_tmpa_tl }
  }
  {\PackageError{OhmyAIMCM-style}{Unsupported~longtable~pagination~hook}%
    {The~measured~table~guard~must~be~adapted~and~tested~for~this~longtable~release.}}
\group_end:
\ExplSyntaxOff
\makeatother

