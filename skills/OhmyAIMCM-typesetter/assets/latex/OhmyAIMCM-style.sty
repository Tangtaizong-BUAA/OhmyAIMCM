% The Python renderer validates every argument before emitting this call.
\newcommand{\OhmyAIMCMApplyStyle}[8]{%
  \geometry{a4paper,top=#1mm,bottom=#2mm,left=#3mm,right=#4mm}%
  \renewcommand{\OhmyAIMCMBodyFontSize}{#5}%
  \renewcommand{\OhmyAIMCMBodyLeading}{#6}%
  \renewcommand{\OhmyAIMCMParagraphIndent}{#7}%
  \setlength{\parskip}{#8em}%
}

\newcommand{\OhmyAIMCMApplyFonts}[3]{%
  \def\OhmyAIMCMRequestedCJK{#1}%
  \ifdefstring{\OhmyAIMCMRequestedCJK}{FandolSong-Regular.otf}{}{\setCJKmainfont{#1}}%
  \setmainfont{#2}%
  \setmathfont{#3}%
}

\newcommand{\OhmyAIMCMApplyHeadingStyle}[7]{%
  \renewcommand{\OhmyAIMCMHOneRatio}{#1}%
  \renewcommand{\OhmyAIMCMHTwoRatio}{#2}%
  \renewcommand{\OhmyAIMCMHThreeRatio}{#3}%
  \renewcommand{\OhmyAIMCMHOneBefore}{#4}%
  \renewcommand{\OhmyAIMCMHOneAfter}{#5}%
  \renewcommand{\OhmyAIMCMHTwoBefore}{#6}%
  \renewcommand{\OhmyAIMCMHTwoAfter}{#7}%
  \renewcommand{\OhmyAIMCMSectionFont}{\Needspace{\OhmyAIMCMHeadingKeepLines\baselineskip}\bfseries\OhmyAIMCMRoleFont{\OhmyAIMCMHOneRole}\fontsize{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHOneRatio}pt}{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHOneRatio*1.30}pt}\selectfont}%
  \renewcommand{\OhmyAIMCMSubsectionFont}{\Needspace{\OhmyAIMCMHeadingKeepLines\baselineskip}\bfseries\OhmyAIMCMRoleFont{\OhmyAIMCMHTwoRole}\fontsize{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHTwoRatio}pt}{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHTwoRatio*1.35}pt}\selectfont}%
  \renewcommand{\OhmyAIMCMSubsubsectionFont}{\Needspace{\OhmyAIMCMHeadingKeepLines\baselineskip}\bfseries\OhmyAIMCMRoleFont{\OhmyAIMCMHTwoRole}\fontsize{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHThreeRatio}pt}{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMHThreeRatio*1.40}pt}\selectfont}%
  \titleformat{\section}{\OhmyAIMCMSectionFont\OhmyAIMCMAlignment{\OhmyAIMCMHOneAlignmentMode}}{\thesection}{0.8em}{}%
  \titleformat{\subsection}{\OhmyAIMCMSubsectionFont}{\thesubsection}{0.75em}{}%
  \titleformat{\subsubsection}{\OhmyAIMCMSubsubsectionFont}{\thesubsubsection}{0.65em}{}%
  \titlespacing*{\section}{0pt}{#4em}{#5em}%
  \titlespacing*{\subsection}{0pt}{#6em}{#7em}%
  \titlespacing*{\subsubsection}{0pt}{\fpeval{#6*0.78}em}{\fpeval{#7*0.78}em}%
}

\newcommand{\OhmyAIMCMApplyRoleStyle}[9]{%
  \renewcommand{\OhmyAIMCMTitleRole}{#1}%
  \renewcommand{\OhmyAIMCMTitleAlignmentMode}{#2}%
  \renewcommand{\OhmyAIMCMTitleRatio}{#3}%
  \renewcommand{\OhmyAIMCMAbstractHeadingRole}{#4}%
  \renewcommand{\OhmyAIMCMAbstractHeadingAlignmentMode}{#5}%
  \renewcommand{\OhmyAIMCMHOneRole}{#6}%
  \renewcommand{\OhmyAIMCMHOneAlignmentMode}{#7}%
  \renewcommand{\OhmyAIMCMHTwoRole}{#8}%
  \renewcommand{\OhmyAIMCMHTwoAlignmentMode}{#9}%
  \titleformat{\section}{\OhmyAIMCMSectionFont\OhmyAIMCMAlignment{\OhmyAIMCMHOneAlignmentMode}}{\thesection}{0.8em}{}%
  \titleformat{\subsection}{\OhmyAIMCMSubsectionFont\OhmyAIMCMAlignment{\OhmyAIMCMHTwoAlignmentMode}}{\thesubsection}{0.75em}{}%
  \titleformat{\subsubsection}{\OhmyAIMCMSubsubsectionFont\OhmyAIMCMAlignment{\OhmyAIMCMHTwoAlignmentMode}}{\thesubsubsection}{0.65em}{}%
}

\newcommand{\OhmyAIMCMApplyNumbering}[1]{%
  \renewcommand{\OhmyAIMCMNumberingStyle}{#1}%
  \def\OhmyAIMCMCurrentNumbering{#1}%
  \ifdefstring{\OhmyAIMCMCurrentNumbering}{chinese_h1_arabic_h2}{%
    \renewcommand{\thesection}{\chinese{section}、}%
    \renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}%
    \renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}%
  }{%
    \renewcommand{\thesection}{\arabic{section}}%
    \renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}%
    \renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}%
  }%
}

\DeclareCaptionFont{OhmyAIMCMcontrolled}{\fontsize{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMCaptionRatio}pt}{\fpeval{\OhmyAIMCMBodyFontSize*\OhmyAIMCMCaptionRatio*1.35}pt}\selectfont}
\newcommand{\OhmyAIMCMApplyCaptionStyle}[3]{%
  \renewcommand{\OhmyAIMCMCaptionRatio}{#1}%
  \captionsetup[figure]{font=OhmyAIMCMcontrolled,labelfont=bf,labelsep=quad,justification=#2,singlelinecheck=false}%
  \captionsetup[table]{font=OhmyAIMCMcontrolled,labelfont=bf,labelsep=quad,justification=#3,singlelinecheck=false}%
