{
  "schema_version": "1.1.0",
  "profile_id": "balanced-cn",
  "page": {
    "margin_top_mm": 25.0,
    "margin_bottom_mm": 25.0,
    "margin_left_mm": 25.0,
    "margin_right_mm": 25.0
  },
  "body": {
    "font_size_pt": 10.5,
    "leading_ratio": 1.44,
    "cjk_font": "FandolSong-Regular.otf",
    "latin_font": "texgyretermes-regular.otf",
    "math_font": "texgyretermes-math.otf"
  },
  "title": {
    "font_role": "serif",
    "alignment": "centered",
    "size_ratio": 1.71
  },
  "abstract": {
    "heading_font_role": "serif",
    "heading_alignment": "centered"
  },
  "headings": {
    "h1_size_ratio": 1.48,
    "h2_size_ratio": 1.25,
    "h3_size_ratio": 1.1,
    "h1_before_em": 1.55,
    "h1_after_em": 0.72,
    "h2_before_em": 1.15,
    "h2_after_em": 0.55,
    "h1_font_role": "serif",
    "h1_alignment": "centered",
    "h2_font_role": "serif",
    "h2_alignment": "left_aligned",
    "numbering_style": "none"
  },
  "captions": {
    "font_size_ratio": 0.88,
    "figure_alignment": "centered",
    "table_alignment": "centered"
  },
  "math": {
    "display_above_em": 0.72,
    "display_below_em": 0.72,
    "array_stretch": 1.18
  },
  "paragraphs": {
    "indent_em": 2.0,
    "paragraph_skip_em": 0.0,
    "first_after_heading_indent": true
  },
  "flow": {
    "widow_penalty": 10000,
    "club_penalty": 10000,
    "heading_keep_lines": 3
  }
}
