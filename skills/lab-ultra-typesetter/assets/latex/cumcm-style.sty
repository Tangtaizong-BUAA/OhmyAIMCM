% Pagination safety, independent of the selected aesthetic Style Tokens.
% At endlongtable, box 0 contains the complete body only if LT@start has not
% run yet.  Measure that existing box and the first head/final foot; never
% typeset a trial copy (which would repeat captions, labels and footnotes).
% Streamed tables and complete tables taller than a page retain longtable's
% ordinary page-breaking output routine, including repeated heads/feet.
\makeatletter
\newdimen\cumcm@TableHeight
\newdimen\cumcm@TableFootHeight
\newcommand{\cumcm@tableSavedNotes}[1]{%
  \ifvoid#1\else
    \advance\cumcm@TableHeight\ht#1%
    \advance\cumcm@TableHeight\dp#1%
    \advance\cumcm@TableHeight\skip\footins
  \fi
}
\newcommand{\cumcm@guardCompletedTable}{%
  \ifx\LT@start\endgraf
    \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=streamed}%
  \else
    \cumcm@TableHeight=\dimexpr\ht\z@+\dp\z@\relax
    \ifvoid\LT@firsthead
      \advance\cumcm@TableHeight\dimexpr\ht\LT@head+\dp\LT@head\relax
    \else
      \advance\cumcm@TableHeight\dimexpr\ht\LT@firsthead+\dp\LT@firsthead\relax
    \fi
    % longtable reserves the ordinary foot before selecting the final foot.
    \cumcm@TableFootHeight=\dimexpr\ht\LT@foot+\dp\LT@foot\relax
    \ifdim\dimexpr\ht\LT@lastfoot+\dp\LT@lastfoot\relax>\cumcm@TableFootHeight
      \cumcm@TableFootHeight=\dimexpr\ht\LT@lastfoot+\dp\LT@lastfoot\relax
    \fi
    \advance\cumcm@TableHeight\cumcm@TableFootHeight
    \advance\cumcm@TableHeight\LTpre
    \advance\cumcm@TableHeight\LTpost
    % Account for the natural page-top allowance and Pandoc's saved notes.
    \advance\cumcm@TableHeight\topskip
    \@ifundefined{FNH@notes}{}{\cumcm@tableSavedNotes\FNH@notes}%
    \@ifundefined{fn@notes}{}{\cumcm@tableSavedNotes\fn@notes}%
    \ifdim\cumcm@TableHeight>\textheight
      \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=breakable height=\the\cumcm@TableHeight}%
    \else
      \typeout{CUMCM-TABLE-GUARD table=\arabic{LT@tables} mode=keep height=\the\cumcm@TableHeight}%
      \Needspace{\cumcm@TableHeight}%
    \fi
  \fi
}
% This exact hook is shared by supported longtable releases.  A changed
% implementation must stop compilation rather than silently lose the guard.
% Replace tokens without retokenizing: current longtable mixes expl3 names and
% ordinary message spaces, which etoolbox's string patch cannot round-trip.
\ExplSyntaxOn
\group_begin:
\tl_set:No \l_tmpa_tl { \endlongtable }
\tl_if_in:NnTF \l_tmpa_tl { \LT@echunk \LT@start }
  {
    \tl_replace_once:Nnn \l_tmpa_tl
      { \LT@echunk \LT@start }
      { \LT@echunk \cumcm@guardCompletedTable \LT@start }
    \cs_gset:Npx \endlongtable { \exp_not:V \l_tmpa_tl }
  }
  {\PackageError{cumcm-style}{Unsupported~longtable~pagination~hook}%
    {The~measured~table~guard~must~be~adapted~and~tested~for~this~longtable~release.}}
\group_end:
\ExplSyntaxOff
\makeatother

\definecolor{cumcmInk}{HTML}{111827}
\definecolor{cumcmRule}{HTML}{334155}

\newcommand{\cumcmBodyFontSize}{10.5}
\newcommand{\cumcmBodyLeading}{14.2}
\newcommand{\cumcmTitleRatio}{1.71}
\newcommand{\cumcmTitleRole}{serif}
\newcommand{\cumcmTitleAlignmentMode}{centered}
\newcommand{\cumcmAbstractHeadingRole}{serif}
\newcommand{\cumcmAbstractHeadingAlignmentMode}{centered}
\newcommand{\cumcmHOneRole}{serif}
\newcommand{\cumcmHOneAlignmentMode}{centered}
\newcommand{\cumcmHTwoRole}{serif}
\newcommand{\cumcmHTwoAlignmentMode}{left_aligned}
\newcommand{\cumcmCaptionRatio}{0.88}
\newcommand{\cumcmNumberingStyle}{none}
\newcommand{\cumcmRoleFont}[1]{%
  \edef\cumcmCurrentRole{#1}%
  \ifdefstring{\cumcmCurrentRole}{sans}{\sffamily\heiti}{\rmfamily\songti}%
}
\newcommand{\cumcmAlignment}[1]{%
  \edef\cumcmCurrentAlignment{#1}%
  \ifdefstring{\cumcmCurrentAlignment}{centered}{\centering}{\raggedright}%
}
\newcommand{\cumcmTitleFont}{\bfseries\cumcmRoleFont{\cumcmTitleRole}\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmTitleRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmTitleRatio*1.28}pt}\selectfont}
\newcommand{\cumcmTitleAlignment}{\cumcmAlignment{\cumcmTitleAlignmentMode}}
\newcommand{\cumcmAbstractHeadingFont}{\bfseries\cumcmRoleFont{\cumcmAbstractHeadingRole}\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmHOneRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmHOneRatio*1.30}pt}\selectfont}
\newcommand{\cumcmAbstractHeadingAlignment}{\cumcmAlignment{\cumcmAbstractHeadingAlignmentMode}}
\newcommand{\cumcmSectionFont}{\bfseries\cumcmRoleFont{\cumcmHOneRole}\fontsize{14pt}{19pt}\selectfont}
\newcommand{\cumcmSubsectionFont}{\bfseries\cumcmRoleFont{\cumcmHTwoRole}\fontsize{12pt}{17pt}\selectfont}
\newcommand{\cumcmSubsubsectionFont}{\bfseries\cumcmRoleFont{\cumcmHTwoRole}\fontsize{10.5pt}{15pt}\selectfont}
\newcommand{\cumcmHOneRatio}{1.48}
\newcommand{\cumcmHTwoRatio}{1.25}
\newcommand{\cumcmHThreeRatio}{1.10}
\newcommand{\cumcmHOneBefore}{1.55}
\newcommand{\cumcmHOneAfter}{0.72}
\newcommand{\cumcmHTwoBefore}{1.15}
\newcommand{\cumcmHTwoAfter}{0.55}
\newcommand{\cumcmDisplayAbove}{0.72}
\newcommand{\cumcmDisplayBelow}{0.72}
\newcommand{\cumcmArrayStretch}{1.18}
\newcommand{\cumcmParagraphIndent}{2.0}
\newcommand{\cumcmWidowPenalty}{10000}
\newcommand{\cumcmClubPenalty}{10000}
\newcommand{\cumcmHeadingKeepLines}{3}
\newif\ifcumcmabstractpagebreak
\cumcmabstractpagebreaktrue
\newif\ifcumcmfirstafterheadingindent
\cumcmfirstafterheadingindenttrue

% The Python renderer validates every argument before emitting this call.
\newcommand{\cumcmApplyStyle}[8]{%
  \geometry{a4paper,top=#1mm,bottom=#2mm,left=#3mm,right=#4mm}%
  \renewcommand{\cumcmBodyFontSize}{#5}%
  \renewcommand{\cumcmBodyLeading}{#6}%
  \renewcommand{\cumcmParagraphIndent}{#7}%
  \setlength{\parskip}{#8em}%
}

\newcommand{\cumcmApplyFonts}[3]{%
  \def\cumcmRequestedCJK{#1}%
  \ifdefstring{\cumcmRequestedCJK}{FandolSong-Regular.otf}{}{\setCJKmainfont{#1}}%
  \setmainfont{#2}%
  \setmathfont{#3}%
}

\newcommand{\cumcmApplyHeadingStyle}[7]{%
  \renewcommand{\cumcmHOneRatio}{#1}%
  \renewcommand{\cumcmHTwoRatio}{#2}%
  \renewcommand{\cumcmHThreeRatio}{#3}%
  \renewcommand{\cumcmHOneBefore}{#4}%
  \renewcommand{\cumcmHOneAfter}{#5}%
  \renewcommand{\cumcmHTwoBefore}{#6}%
  \renewcommand{\cumcmHTwoAfter}{#7}%
  \renewcommand{\cumcmSectionFont}{\Needspace{\cumcmHeadingKeepLines\baselineskip}\bfseries\cumcmRoleFont{\cumcmHOneRole}\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmHOneRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmHOneRatio*1.30}pt}\selectfont}%
  \renewcommand{\cumcmSubsectionFont}{\Needspace{\cumcmHeadingKeepLines\baselineskip}\bfseries\cumcmRoleFont{\cumcmHTwoRole}\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmHTwoRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmHTwoRatio*1.35}pt}\selectfont}%
  \renewcommand{\cumcmSubsubsectionFont}{\Needspace{\cumcmHeadingKeepLines\baselineskip}\bfseries\cumcmRoleFont{\cumcmHTwoRole}\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmHThreeRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmHThreeRatio*1.40}pt}\selectfont}%
  \titleformat{\section}{\cumcmSectionFont\cumcmAlignment{\cumcmHOneAlignmentMode}}{\thesection}{0.8em}{}%
  \titleformat{\subsection}{\cumcmSubsectionFont}{\thesubsection}{0.75em}{}%
  \titleformat{\subsubsection}{\cumcmSubsubsectionFont}{\thesubsubsection}{0.65em}{}%
  \titlespacing*{\section}{0pt}{#4em}{#5em}%
  \titlespacing*{\subsection}{0pt}{#6em}{#7em}%
  \titlespacing*{\subsubsection}{0pt}{\fpeval{#6*0.78}em}{\fpeval{#7*0.78}em}%
}

\newcommand{\cumcmApplyRoleStyle}[9]{%
  \renewcommand{\cumcmTitleRole}{#1}%
  \renewcommand{\cumcmTitleAlignmentMode}{#2}%
  \renewcommand{\cumcmTitleRatio}{#3}%
  \renewcommand{\cumcmAbstractHeadingRole}{#4}%
  \renewcommand{\cumcmAbstractHeadingAlignmentMode}{#5}%
  \renewcommand{\cumcmHOneRole}{#6}%
  \renewcommand{\cumcmHOneAlignmentMode}{#7}%
  \renewcommand{\cumcmHTwoRole}{#8}%
  \renewcommand{\cumcmHTwoAlignmentMode}{#9}%
  \titleformat{\section}{\cumcmSectionFont\cumcmAlignment{\cumcmHOneAlignmentMode}}{\thesection}{0.8em}{}%
  \titleformat{\subsection}{\cumcmSubsectionFont\cumcmAlignment{\cumcmHTwoAlignmentMode}}{\thesubsection}{0.75em}{}%
  \titleformat{\subsubsection}{\cumcmSubsubsectionFont\cumcmAlignment{\cumcmHTwoAlignmentMode}}{\thesubsubsection}{0.65em}{}%
}

\newcommand{\cumcmApplyNumbering}[1]{%
  \renewcommand{\cumcmNumberingStyle}{#1}%
  \def\cumcmCurrentNumbering{#1}%
  \ifdefstring{\cumcmCurrentNumbering}{chinese_h1_arabic_h2}{%
    \renewcommand{\thesection}{\chinese{section}、}%
    \renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}%
    \renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}%
  }{%
    \renewcommand{\thesection}{\arabic{section}}%
    \renewcommand{\thesubsection}{\arabic{section}.\arabic{subsection}}%
    \renewcommand{\thesubsubsection}{\arabic{section}.\arabic{subsection}.\arabic{subsubsection}}%
  }%
}

\DeclareCaptionFont{cumcmcontrolled}{\fontsize{\fpeval{\cumcmBodyFontSize*\cumcmCaptionRatio}pt}{\fpeval{\cumcmBodyFontSize*\cumcmCaptionRatio*1.35}pt}\selectfont}
\newcommand{\cumcmApplyCaptionStyle}[3]{%
  \renewcommand{\cumcmCaptionRatio}{#1}%
  \captionsetup[figure]{font=cumcmcontrolled,labelfont=bf,labelsep=quad,justification=#2,singlelinecheck=false}%
  \captionsetup[table]{font=cumcmcontrolled,labelfont=bf,labelsep=quad,justification=#3,singlelinecheck=false}%
}

\newcommand{\cumcmApplyMathStyle}[3]{%
  \renewcommand{\cumcmDisplayAbove}{#1}%
  \renewcommand{\cumcmDisplayBelow}{#2}%
  \renewcommand{\cumcmArrayStretch}{#3}%
}

\newcommand{\cumcmApplyFlowStyle}[4]{%
  \renewcommand{\cumcmWidowPenalty}{#1}%
  \renewcommand{\cumcmClubPenalty}{#2}%
  \renewcommand{\cumcmHeadingKeepLines}{#3}%
  \csname cumcmfirstafterheadingindent#4\endcsname
}

\makeatletter
\newcommand{\cumcmEnableFirstIndent}{\let\@afterindentfalse\@afterindenttrue}
\makeatother

\AtBeginDocument{%
  \color{cumcmInk}%
  \fontsize{\cumcmBodyFontSize pt}{\cumcmBodyLeading pt}\selectfont
  % ctexart initializes its paragraph layout at begin-document time.  Apply the
  % validated token here so that the class cannot silently overwrite it.
  \setlength{\parindent}{\cumcmParagraphIndent em}%
  \setlength{\abovedisplayskip}{\cumcmDisplayAbove em plus 0.2em minus 0.15em}%
  \setlength{\belowdisplayskip}{\cumcmDisplayBelow em plus 0.2em minus 0.15em}%
  \setlength{\abovedisplayshortskip}{\cumcmDisplayAbove em plus 0.15em minus 0.1em}%
  \setlength{\belowdisplayshortskip}{\cumcmDisplayBelow em plus 0.15em minus 0.1em}%
  \renewcommand{\arraystretch}{\cumcmArrayStretch}%
  \widowpenalty=\cumcmWidowPenalty
  \clubpenalty=\cumcmClubPenalty
  \displaywidowpenalty=\cumcmWidowPenalty
  \ifcumcmfirstafterheadingindent\cumcmEnableFirstIndent\fi
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}\renewcommand{\headrulewidth}{0pt}}

\titleformat{\section}{\cumcmSectionFont\cumcmAlignment{\cumcmHOneAlignmentMode}}{\thesection}{0.8em}{}
\titleformat{\subsection}{\cumcmSubsectionFont\cumcmAlignment{\cumcmHTwoAlignmentMode}}{\thesubsection}{0.75em}{}
\titleformat{\subsubsection}{\cumcmSubsubsectionFont\cumcmAlignment{\cumcmHTwoAlignmentMode}}{\thesubsubsection}{0.65em}{}
\titlespacing*{\section}{0pt}{1.45em}{0.75em}
\titlespacing*{\subsection}{0pt}{1.15em}{0.55em}
\titlespacing*{\subsubsection}{0pt}{0.9em}{0.4em}

\captionsetup{font=cumcmcontrolled,labelfont=bf,labelsep=quad,justification=centering,singlelinecheck=false}
\setlist{nosep,leftmargin=2em,topsep=0.35em}
\setlength{\textfloatsep}{1.0em plus 0.2em minus 0.2em}
\setlength{\floatsep}{0.8em plus 0.2em minus 0.2em}
\setlength{\intextsep}{0.8em plus 0.2em minus 0.2em}

\renewenvironment{abstract}{%
  \par\begingroup
  \vspace*{\cumcmHOneBefore em}%
  {\cumcmAbstractHeadingFont\cumcmAbstractHeadingAlignment 摘要\par}%
  \vspace{\cumcmHOneAfter em}%
  \setlength{\parindent}{\cumcmParagraphIndent em}%
}{%
  \par\endgroup
  \ifcumcmabstractpagebreak\clearpage\fi
}

\newenvironment{keywords}{%
  \par\vspace{0.5em}\noindent\textbf{关键词：}\ignorespaces
}{\par}

