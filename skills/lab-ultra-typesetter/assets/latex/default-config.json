{
  "version": 1,
  "rules": {
    "paper_size": "a4",
    "minimum_margin_mm": 25.0,
    "anonymous": true,
    "abstract_required": true,
    "abstract_first_page": true,
    "abstract_max_pages": 1,
    "allow_toc": false,
    "body_max_pages": 30,
    "pdf_max_bytes": 20971520
  },
  "content_lock": {
    "allow_raw_tex": false,
    "minimum_pdf_text_similarity": 0.90
  },
  "style_tokens": {
    "margin_top_mm": 25.0,
    "margin_bottom_mm": 25.0,
    "margin_left_mm": 25.0,
    "margin_right_mm": 25.0,
    "body_font_pt": 10.5,
    "line_height_ratio": 1.44,
    "cjk_font": "FandolSong-Regular.otf",
    "latin_font": "texgyretermes-regular.otf",
    "math_font": "texgyretermes-math.otf",
    "title_font_role": "serif",
    "title_alignment": "centered",
    "title_size_ratio": 1.71,
    "abstract_heading_font_role": "serif",
    "abstract_heading_alignment": "centered",
    "h1_size_ratio": 1.48,
    "h2_size_ratio": 1.25,
    "h3_size_ratio": 1.1,
    "h1_before_em": 1.55,
    "h1_after_em": 0.72,
    "h2_before_em": 1.15,
    "h2_after_em": 0.55,
    "h1_font_role": "serif",
    "h1_alignment": "centered",
    "h2_font_role": "serif",
    "h2_alignment": "left_aligned",
    "section_numbering_style": "none",
    "caption_font_ratio": 0.88,
    "figure_caption_alignment": "centered",
    "table_caption_alignment": "centered",
    "display_above_em": 0.72,
    "display_below_em": 0.72,
    "array_stretch": 1.18,
    "paragraph_indent_em": 2.0,
    "paragraph_skip_em": 0.0,
    "first_after_heading_indent": true,
    "widow_penalty": 10000,
    "club_penalty": 10000,
    "heading_keep_lines": 3,
    "abstract_page_break": true
  }
}
